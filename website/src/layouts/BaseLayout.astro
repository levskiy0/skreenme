---
import { DOWNLOAD_URL } from '../site';
import { englishPath, getHeaderNav, getUi, languageNames, languageTags, locales, withLocale, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  articleModified?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
  active?: 'features' | 'guides' | 'changelog';
  locale?: Locale;
}

const {
  title,
  description,
  image = '/assets/skreen-mascot.png',
  article = false,
  articleModified,
  noindex = false,
  structuredData,
  active,
  locale = 'en',
} = Astro.props;
const ui = getUi(locale);
const headerNav = getHeaderNav(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const path = englishPath(Astro.url.pathname);
const alternateUrl = (language: Locale) => new URL(withLocale(language, path), Astro.site).toString();
---

<!doctype html>
<html lang={languageTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f9faf9" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && locales.map((language) => <link rel="alternate" hreflang={languageTags[language]} href={alternateUrl(language)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternateUrl('en')} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Skreen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={ui.socialImageAlt} />
    <meta property="og:locale" content={languageTags[locale].replace('-', '_')} />
    {articleModified && <meta property="article:modified_time" content={articleModified} />}
    <meta name="twitter:card" content={image === '/assets/skreen-mascot.png' ? 'summary' : 'summary_large_image'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=5" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/skreen-favicon-32.png?v=5" />
    <link rel="apple-touch-icon" sizes="512x512" href="/assets/skreen-favicon.png?v=5" />
    <link rel="preload" href="/assets/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/site.css" />
    <link rel="stylesheet" href="/assets/css/interior.css" />
    <link rel="stylesheet" href="/assets/css/site-shell.css" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <header class="site-header" id="top">
      <div class="island-shell">
        <div class="header-inner">
          <a class="brand" href={withLocale(locale, '/')} aria-label={ui.homeLabel}><span class="brand-icon"><img src="/assets/skreen-mascot.png" width="512" height="512" alt="" aria-hidden="true" /></span><span class="brand-name">skreen</span></a>
          <nav class="nav" id="site-primary-navigation" aria-label={ui.mainNavigation}>
            <a href={withLocale(locale, '/features')} aria-current={active === 'features' ? 'page' : undefined}>{headerNav.features}</a>
            <a href={withLocale(locale, '/guides/how-to-screenshot-on-mac')} aria-current={active === 'guides' ? 'page' : undefined}>{headerNav.macGuide}</a>
            <a href={withLocale(locale, '/#faq')}>{headerNav.faq}</a>
            <a href={withLocale(locale, '/changelog')} aria-current={active === 'changelog' ? 'page' : undefined}>{headerNav.releases}</a>
          </nav>
          <div class="island-actions">
            {!noindex && <details class="language-switcher"><summary aria-label={languageNames[locale]}>{locale.toUpperCase()}</summary><div class="language-options">{locales.map((language) => <a href={withLocale(language, path)} lang={languageTags[language]} aria-current={locale === language ? 'page' : undefined}>{languageNames[language]}</a>)}</div></details>}
            <a class="header-download" href={DOWNLOAD_URL} aria-label={ui.downloadSkreen} data-download-cta>{ui.download}</a>
            <button class="island-menu-button" type="button" aria-label={ui.openNavigation} data-open-label={ui.openNavigation} data-close-label={ui.closeNavigation} aria-controls="site-primary-navigation" aria-expanded="false"><span class="island-menu-lines" aria-hidden="true"></span></button>
          </div>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container footer-main">
        <div class="footer-intro">
          <a class="brand" href={withLocale(locale, '/')} aria-label={ui.homeLabel}><span class="brand-icon"><img src="/assets/skreen-mascot.png" width="512" height="512" alt="" aria-hidden="true" /></span><span class="brand-name">skreen</span></a>
          <p>{ui.footerTagline}</p>
          <a class="footer-contact" href="https://github.com/levskiy0/skreenme/issues">{ui.haveIdea}</a>
        </div>
        <nav class="footer-sitemap" aria-label={ui.footerNavigation}>
          <div class="footer-column"><h2>{ui.product}</h2><a href={withLocale(locale, '/features')}>{ui.features}</a><a href={DOWNLOAD_URL} data-download-cta>{ui.downloadForMac}</a></div>
          <div class="footer-column"><h2>{ui.explore}</h2><a href={withLocale(locale, '/guides/how-to-screenshot-on-mac')}>{ui.macGuide}</a><a href={withLocale(locale, '/#faq')}>{ui.faq}</a><a href={withLocale(locale, '/changelog')}>{ui.releases}</a></div>
          <div class="footer-column"><h2>{ui.elsewhere}</h2><a href="https://github.com/levskiy0/skreenme">GitHub</a><a href="https://github.com/levskiy0/skreenme/issues">{ui.feedback}</a></div>
        </nav>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} Skreen</span><span>{ui.madeForMac}</span><a href="#top">{ui.backToTop}</a></div>
      <a class="footer-wordmark" href={withLocale(locale, '/')} aria-label={ui.homeLabel}>skreen</a>
    </footer>
    <script is:inline src="/assets/js/site-shell.js" defer></script>
    <script is:inline src="/assets/js/reveal.js" defer></script>
    <script is:inline>
      if (location.hostname === 'skreenme.com' || location.hostname === 'www.skreenme.com') {
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();for(var j=0;j<e.scripts.length;j++){if(e.scripts[j].src===r){return;}}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a);
        })(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
        ym(105348782, 'init', {clickmap:true, trackLinks:true, accurateTrackBounce:true});
        document.querySelectorAll('[data-download-cta]').forEach(function(link) {
          link.addEventListener('click', function() { ym(105348782, 'reachGoal', 'download_click'); });
        });
      }
    </script>
  </body>
</html>
