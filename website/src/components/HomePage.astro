---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmbientParticles from './AmbientParticles.astro';
import { DOWNLOAD_URL, VERSION } from '../site';
import { canonicalInternalPath, getUi, withLocale, type Locale } from '../i18n';

interface HomeData {
  title: string;
  description: string;
  hero_title: string;
  hero_title_accent: string;
  hero_description: string;
  download_label: string;
  hero_note: string;
  features: { title: string; body: string; url: string; icon: string; label: string }[];
  workflow: { title: string; body: string }[];
  faq: { question: string; answer: string }[];
}

interface Props { data: HomeData; locale: Locale }
const { data: h, locale } = Astro.props;
const ui = getUi(locale);
const heroImageWidths = [640, 960, 1280, 1920, 2414];
const heroImageSrcSet = (format: 'avif' | 'webp') =>
  heroImageWidths.map((width) => `/assets/skreen-editor-clouds-${width}.${format} ${width}w`).join(', ');
const heroImageSizes = '(max-width: 620px) calc(100vw - 32px), (max-width: 820px) calc(100vw - 42px), (max-width: 1224px) calc(100vw - 64px), 1160px';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Skreen',
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  description: h.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS 14 or later',
  softwareVersion: VERSION,
  downloadUrl: DOWNLOAD_URL,
};
---

<BaseLayout title={h.title} description={h.description} image="/assets/skreen-editor-clouds.png" structuredData={structuredData} locale={locale}>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-layout">
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow">{ui.heroEyebrow}</p>
          <img class="hero-app-mark" src="/assets/skreen-mascot.png" width="512" height="512" alt="" aria-hidden="true" />
          <h1 id="hero-title">{h.hero_title} <span>{h.hero_title_accent}</span></h1>
          <p class="hero-description">{h.hero_description}</p>
          <div class="hero-actions"><a class="button button-primary" href={DOWNLOAD_URL} data-download-cta>{h.download_label}</a><a class="button button-secondary" href="#see-it">{ui.seeHow}</a></div>
          <p class="hero-note">{h.hero_note}</p>
        </div>
        <picture class="hero-picture">
          <source type="image/avif" srcset={heroImageSrcSet('avif')} sizes={heroImageSizes} />
          <source type="image/webp" srcset={heroImageSrcSet('webp')} sizes={heroImageSizes} />
          <img class="hero-device" src="/assets/skreen-editor-clouds.png" width="2414" height="1650" alt={ui.editorImageAlt} fetchpriority="high" decoding="async" />
        </picture>
      </div>
    </section>
    <section class="proof-strip" aria-label={ui.proofLabel}><div class="container proof-grid">
      {ui.proof.map((item, index) => <div class="proof-item"><img class="proof-icon" src={['/assets/icon-scrolling-capture.png', '/assets/icon-annotations.png', '/assets/icon-redaction.png'][index]} width="512" height="512" alt="" aria-hidden="true" loading="lazy" /><h2>{item.title}</h2><p>{item.body}</p></div>)}
    </div></section>
    <section class="showcase" id="features" aria-labelledby="showcase-title"><div class="container">
      <div class="showcase-heading"><div><p class="eyebrow">{ui.editor}</p><h2 id="showcase-title">{ui.editorTitle}<br /><em>{ui.editorAccent}</em></h2></div><p>{ui.editorLead}</p></div>
      <div class="showcase-feature-list">{h.features.map((feature) => <article class="showcase-feature"><img class="showcase-feature-icon" src={feature.icon} width="512" height="512" alt="" aria-hidden="true" loading="lazy" /><div class="showcase-feature-copy"><h3>{feature.title}</h3><p>{feature.body}</p><a class="text-link" href={canonicalInternalPath(feature.url)}>{ui.exploreFeature} {feature.label}</a></div></article>)}</div>
    </div></section>
    <section class="workflow" id="see-it" aria-labelledby="workflow-title"><div class="container">
      <div class="workflow-heading"><p class="eyebrow">{ui.workflow}</p><h2 id="workflow-title">{ui.workflowTitle}<br /><em>{ui.workflowAccent}</em></h2><p>{ui.workflowLead}</p><img class="workflow-icon" src="/assets/icon-editor.png" width="512" height="512" alt="" aria-hidden="true" loading="lazy" /></div>
      <div class="workflow-steps workflow-steps--full">{h.workflow.map((step, index) => <article class="workflow-step"><span>0{index + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></article>)}</div>
      <nav class="more-features" aria-label={ui.moreFeatures}><span>{ui.moreToExplore}</span><a href={withLocale(locale, '/features/ocr-and-qr')}>{ui.textQr}</a><a href={withLocale(locale, '/features/combine-screenshots')}>{ui.combineScreenshots}</a><a href={withLocale(locale, '/features')}>{ui.allFeatures}</a></nav>
    </div></section>
    <section class="faq" id="faq" aria-labelledby="faq-title"><AmbientParticles className="faq-particles" /><div class="container"><div class="faq-heading"><p class="eyebrow">{ui.goodToKnow}</p><h2 id="faq-title">{ui.faqTitle} <em>{ui.faqAccent}</em></h2></div><div class="faq-list">{h.faq.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true"></span></summary><p>{item.answer}</p></details>)}</div></div></section>
    <section class="download-close" aria-labelledby="download-close-title">
      <div class="download-close-scene">
        <div class="download-close-landscape" aria-hidden="true"></div>
        <div class="container download-close-inner">
          <div class="download-close-copy">
            <p class="eyebrow">{ui.ready}</p>
            <h2 id="download-close-title">{ui.finalTitle}<br /><em>{ui.finalAccent}</em></h2>
            <p>{ui.finalLead}</p>
            <div class="download-close-action"><a class="button button-primary" href={DOWNLOAD_URL} data-download-cta>{h.download_label}</a><span>{h.hero_note}</span></div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <script is:inline src="/assets/js/home.js" defer></script>
</BaseLayout>
