---
import { DOWNLOAD_URL } from '../site';
interface Props { titleId: string }
const { titleId } = Astro.props;
---
<section class="page-cta" aria-labelledby={titleId}>
  <div class="article-banner-particles wide-banner-particles" aria-hidden="true"><span class="particle-dot"></span><span class="particle-ring"></span><span class="particle-plus"></span><span class="particle-diamond"></span><span class="particle-dot"></span><span class="particle-ring"></span><span class="particle-plus"></span><span class="particle-dot"></span><span class="particle-diamond"></span><span class="particle-plus"></span><span class="particle-ring"></span><span class="particle-dot"></span></div>
  <div class="container page-cta-inner">
    <div><h2 id={titleId}>Make your next screenshot with Skreen.</h2><p>Capture, edit, and protect it in one native Mac app.</p></div>
    <a class="button button-primary" href={DOWNLOAD_URL} data-download-cta>Download Skreen for Mac</a>
  </div>
</section>
