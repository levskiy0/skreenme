---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DOWNLOAD_URL, VERSION } from '../site';
import pages from '../data/pages.json';

interface HomeData {
  title: string;
  description: string;
  hero_title: string;
  hero_title_accent: string;
  hero_description: string;
  download_label: string;
  hero_note: string;
  features: { title: string; body: string; url: string; icon: string; label: string }[];
  workflow: { title: string; body: string }[];
  faq: { question: string; answer: string }[];
}

const h = pages.home as HomeData;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Skreen',
  url: 'https://skreenme.com/',
  description: h.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS 14 or later',
  softwareVersion: VERSION,
  downloadUrl: DOWNLOAD_URL,
};
---

<BaseLayout title={h.title} description={h.description} image="/assets/skreen-editor-chameleon-food.png" structuredData={structuredData}>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-layout">
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow">A screenshot app made for Mac</p>
          <img class="hero-app-mark" src="/assets/skreen-mascot.png" width="512" height="512" alt="" aria-hidden="true" />
          <h1 id="hero-title">{h.hero_title} <span>{h.hero_title_accent}</span></h1>
          <p class="hero-description">{h.hero_description}</p>
          <p class="sr-only">Press Shift, Command, and 0 to capture an area, then annotate and style it in Skreen.</p>
          <div class="hero-actions"><a class="button button-primary" href={DOWNLOAD_URL} data-download-cta>{h.download_label}</a><a class="button button-secondary" href="#see-it">See how it works</a></div>
          <p class="hero-note">{h.hero_note}</p>
        </div>
        <figure class="hero-device">
          <div class="hero-story-sticky">
            <div class="hero-story-stage">
              <div class="hero-story-intro" aria-hidden="true"><img src="/assets/skreen-editor-clouds.png" width="2414" height="1650" alt="" fetchpriority="high" decoding="async" /></div>
              <div class="hero-story-keys" aria-hidden="true">
                <div class="hero-story-key-row">
                  <span class="hero-story-key" data-story-key="0"><kbd>Shift</kbd></span>
                  <span class="hero-story-key" data-story-key="1"><kbd>⌘</kbd></span>
                  <span class="hero-story-key" data-story-key="2"><kbd>0</kbd></span>
                </div>
              </div>
              <div class="hero-story-product" aria-hidden="true">
                <div class="hero-product-card">
                  <div class="hero-product-photo">
                    <span class="hero-product-photo-label">FOR CURIOUS CHAMELEONS</span>
                    <img class="hero-product-art" src="/assets/chameleon-food-pouch.webp" width="800" height="1200" alt="" decoding="async" />
                  </div>
                  <div class="hero-product-info">
                    <div class="hero-product-brand"><span>LITTLE WILD</span><span>EST. 2026</span></div>
                    <div class="hero-product-details"><span>CHAMELEON TREATS</span><h3>Cricket Mix</h3><p>A crunchy little treat for your favorite color changer.</p><div class="hero-product-meta">Dried crickets · Botanical blend</div></div>
                    <div class="hero-product-bottom"><strong>$18</strong><span>Add to bag ↗</span></div>
                  </div>
                </div>
                <div class="hero-product-selection"><svg class="hero-selection-cursor" viewBox="0 0 56 56" fill="none" aria-hidden="true"><path d="M28 3v18m0 14v18M3 28h18m14 0h18" stroke="#fff" stroke-width="7" stroke-linecap="round"/><path d="M28 3v18m0 14v18M3 28h18m14 0h18" stroke="#1d1d1d" stroke-width="3" stroke-linecap="round"/></svg></div>
              </div>
              <div class="hero-editor">
                <img class="hero-editor-empty" src="/assets/skreen-editor-empty.png" width="2414" height="1650" alt="" aria-hidden="true" decoding="async" />
                <img class="hero-editor-capture" src="/assets/skreen-editor-chameleon-food.png" width="2414" height="1650" alt="Skreen editor with the captured chameleon food product card" decoding="async" />
              </div>
              <div class="hero-capture-flash" aria-hidden="true"></div>
            </div>
          </div>
        </figure>
      </div>
    </section>
    <section class="proof-strip" aria-label="Why Skreen"><div class="container proof-grid">
      <div class="proof-item"><img class="proof-icon" src="/assets/icon-scrolling-capture.png" width="512" height="512" alt="" aria-hidden="true" loading="lazy" /><h2>A whole page, one image.</h2><p>Keep scrolling. You decide where the capture stops.</p></div>
      <div class="proof-item"><img class="proof-icon" src="/assets/icon-annotations.png" width="512" height="512" alt="" aria-hidden="true" loading="lazy" /><h2>Point to what matters.</h2><p>Add an arrow, a note, or a frame before you send it.</p></div>
      <div class="proof-item"><img class="proof-icon" src="/assets/icon-redaction.png" width="512" height="512" alt="" aria-hidden="true" loading="lazy" /><h2>Cover private details.</h2><p>Review local detection and hide sensitive parts before export.</p></div>
    </div></section>
    <section class="showcase" id="features" aria-labelledby="showcase-title"><div class="container">
      <div class="showcase-heading"><div><p class="eyebrow">The editor</p><h2 id="showcase-title">One place for the<br /><em>whole screenshot.</em></h2></div><p>Capture what matters, make it clear, and finish the image in the editor.</p></div>
      <div class="showcase-feature-list">{h.features.map((feature) => <article class="showcase-feature"><img class="showcase-feature-icon" src={feature.icon} width="512" height="512" alt="" aria-hidden="true" loading="lazy" /><div class="showcase-feature-copy"><h3>{feature.title}</h3><p>{feature.body}</p><a class="text-link" href={feature.url}>Explore {feature.label.toLowerCase()}</a></div></article>)}</div>
    </div></section>
    <section class="workflow" id="see-it" aria-labelledby="workflow-title"><div class="container">
      <div class="workflow-heading"><p class="eyebrow">The workflow</p><h2 id="workflow-title">From keyboard shortcut<br /><em>to finished image.</em></h2><p>Capture an area, window, or scrolling view. Make the changes you need, then export the result.</p><img class="workflow-icon" src="/assets/icon-editor.png" width="512" height="512" alt="" aria-hidden="true" loading="lazy" /></div>
      <div class="workflow-steps workflow-steps--full">{h.workflow.map((step, index) => <article class="workflow-step"><span>0{index + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></article>)}</div>
      <nav class="more-features" aria-label="More Skreen features"><span>And there is more to explore</span><a href="/features/ocr-and-qr">Text and QR recognition</a><a href="/features/combine-screenshots">Combine screenshots</a><a href="/features">All features</a></nav>
    </div></section>
    <section class="faq" id="faq" aria-labelledby="faq-title"><div class="container"><div class="faq-heading"><p class="eyebrow">Good to know</p><h2 id="faq-title">A few useful <em>answers.</em></h2></div><div class="faq-list">{h.faq.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true"></span></summary><p>{item.answer}</p></details>)}</div></div></section>
    <section class="download-close" aria-labelledby="download-close-title">
      <div class="download-close-scene">
        <div class="download-close-landscape" aria-hidden="true"></div>
        <div class="container download-close-inner">
          <div class="download-close-copy">
            <p class="eyebrow">Ready when you are</p>
            <h2 id="download-close-title">Your next screenshot,<br /><em>finished in Skreen.</em></h2>
            <p>Capture, edit, and export in one native Mac app.</p>
            <div class="download-close-action"><a class="button button-primary" href={DOWNLOAD_URL} data-download-cta>{h.download_label}</a><span>{h.hero_note}</span></div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <script is:inline src="/assets/js/home.js" defer></script>
</BaseLayout>
