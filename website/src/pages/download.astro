---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DOWNLOAD_URL, VERSION } from '../site';
---
<BaseLayout title="Download Skreen for Mac" description={`Download Skreen ${VERSION} for macOS 14 or later.`} noindex>
  <meta slot="head" http-equiv="refresh" content={`0;url=${DOWNLOAD_URL}`} />
  <main id="main" class="article-main"><section class="page-hero index-hero"><div class="container index-hero-inner"><h1>Download Skreen for Mac.</h1><p>If the download did not start, use the link below.</p><a class="button button-primary" href={DOWNLOAD_URL} data-download-cta>Download Skreen {VERSION}</a></div></section></main>
</BaseLayout>
