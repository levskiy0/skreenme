---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Skreen" description="The requested Skreen page could not be found." noindex={true}>
  <section class="download-page section">
    <div class="shell">
      <p class="eyebrow">404 · outside the capture area</p>
      <h1 class="display">Nothing useful in this frame.</h1>
      <p>The page moved, the URL changed, or this part of the screen was never captured.</p>
      <a class="button" href="/">Return to Skreen →</a>
    </div>
  </section>
</BaseLayout>
